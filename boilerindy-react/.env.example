# BoilerIndy - Frontend environment variables (Vite)
# Copy this file to .env and fill in your values.
#
#   cp .env.example .env      (macOS/Linux)
#   copy .env.example .env    (Windows)
#
# Only VITE_* variables are bundled into the browser build.
# NEVER put SUPABASE_SERVICE_ROLE_KEY or GEMINI_API_KEY here.
# Backend secrets belong in ../.env

# ── Supabase (public keys - safe to expose in the browser) ───────────────────
# Find these in your Supabase project: Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# ── Backend proxy (optional) ──────────────────────────────────────────────────
# Vite proxies /api/* and /auth/purdue/* to this address during development.
# Default is http://127.0.0.1:3000 - only change if your backend runs elsewhere.
# VITE_API_PROXY=http://127.0.0.1:3000

# ── Sentry error tracking (optional, issue #50) ──────────────────────────────
# React project DSN from sentry.io (public - DSNs are not secrets, but leave
# blank locally: with no DSN, Sentry is fully disabled and zero events leave
# the browser). Set the real values on the host (e.g. Vercel dashboard).
VITE_SENTRY_DSN=
# Build-time only (sourcemap upload via @sentry/vite-plugin). The auth token IS
# a secret - host dashboard only, never the repo.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
