# BoilerIndy - Backend environment variables
# Copy this file to .env and fill in your values.
#
#   cp .env.example .env
#
# NEVER commit .env to git. It is already in .gitignore.

# ── Supabase ──────────────────────────────────────────────────────────────────
# Find these in your Supabase project: Settings → API

# Project URL (same for backend and frontend)
SUPABASE_URL=https://your-project-id.supabase.co

# Service role key - has full DB access, keep secret, backend only
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Anon / public key - required for Supabase Auth password verification (never use service role here)
SUPABASE_ANON_KEY=your-anon-public-key-here

# ── Express server ────────────────────────────────────────────────────────────
PORT=3000
HOST=127.0.0.1

# Use a long random string in production (required when NODE_ENV=production).
SESSION_SECRET=change-this-to-a-long-random-string

# ── Frontend URL (for auth redirects) ─────────────────────────────────────────
# Must match the port Vite is running on (default: 5173)
CLIENT_APP_URL=http://localhost:5173

# ── Purdue auth ───────────────────────────────────────────────────────────────
# 'mock' for local development - skips real Purdue CAS login
# 'cas'  for production - requires PURDUE_CAS_LOGIN_URL and PURDUE_CAS_VALIDATE_URL
PURDUE_AUTH_MODE=mock

# Pre-filled email shown on the mock Purdue link screen (dev only)
DEV_PURDUE_EMAIL=student@purdue.edu

# URL scheme the native app registers. The Purdue link handoff (issue #214,
# docs/purdue-link.md) returns to <scheme>://purdue-linked. Default: boilerindyapp
NATIVE_APP_SCHEME=boilerindyapp

# Purdue schedule auto-capture (dev only, off by default). When on, the
# /api/purdue/calendar-link/* routes open a visible Chromium on the machine
# running the server so you can log in and the app captures your UniTime
# iCalendar URL. That cannot work on Render (no display, no browser), so the
# routes always 404 in production. Set to 1 / true / on to enable locally after
# `pnpm exec playwright install chromium`; otherwise paste the URL by hand.
PURDUE_CALENDAR_AUTOMATION=0

# UniTime page the auto-capture browser opens first. Leave blank for the
# default (https://timetable.mypurdue.purdue.edu/Timetabling/personal).
PURDUE_UNITIME_PERSONAL_SCHEDULE_URL=

# Comma-separated student emails with platform admin access (also set is_admin in DB)
ADMIN_EMAILS=

# ── Rate limiting (optional) ──────────────────────────────────────────────────
# All API rate limiters are ON by default. See docs/RATE_LIMITS.md for the
# endpoint coverage table and per-limiter override variables, e.g.:
#   RATE_LIMIT_SIGN_IN_MAX=20
#   RATE_LIMIT_SIGN_IN_WINDOW_MS=900000
# Set to false only for local load testing.
RATE_LIMIT_ENABLED=true

# ── Community text filter (optional, issue #209) ──────────────────────────────
# Extra words to block on every community write (board posts and replies, lost
# and found, guide, study groups, marketplace, friend bio), on top of the base
# list in src/boardProfanity.mjs. Comma-separated, case does not matter,
# entries shorter than 2 characters are ignored. Words match whole words only.
# The base list covers slurs, sexual terms and strong profanity; add anatomy or
# mild slang back here if you want it blocked. Read on first use and cached, so
# restart the server after changing it. Leave blank for the base list only.
BOARD_BLOCKED_WORDS=

# ── Groq AI (optional) ────────────────────────────────────────────────────────
# Powers the campus assistant (/api/assistant) and board AI features via Groq
# (groq.com, GroqCloud), not xAI's Grok: same-sounding name, different company,
# and a key from one is rejected by the other. Create a key at
# https://console.groq.com (API Keys); keys start with "gsk_". Leave blank to
# run without AI: the assistant answers with an offline notice, board AI
# suggestions return a 503, new posts are not auto-tagged, everything else works.
GROQ_API_KEY=your-groq-api-key-here
# Model id from https://console.groq.com/docs/models. Default:
# openai/gpt-oss-120b, a reasoning model that answers fast at low effort.
# GROQ_MODEL=openai/gpt-oss-120b
# Retried once when GROQ_MODEL answers 429. Groq rate-limits each model
# separately, so a smaller model often still has room when the main one is
# capped. Default openai/gpt-oss-20b; set it empty to turn the retry off.
# GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
# Optional, gpt-oss models only: low | medium | high (default low).
# GROQ_REASONING_EFFORT=low

# ── Transit (optional) ────────────────────────────────────────────────────────
# TransLoc API key for campus bus proxy endpoints
TRANSLOC_API_KEY=your-transloc-api-key-here

# ── Sentry error tracking (optional, issue #50) ──────────────────────────────
# Node project DSN from sentry.io. Leave blank locally - with no DSN, Sentry is
# fully disabled and zero events are sent. Set the real value on the host
# (e.g. Render dashboard), never in the repo.
SENTRY_DSN=

# ── Email / Resend (optional) ─────────────────────────────────────────────────
# Powers the advertiser self-serve password reset (forgot-password). Leave both
# blank locally - with no key the reset email is skipped and the reset link is
# logged to the server console instead, so the flow is still testable in dev.
# Get a key at https://resend.com → API Keys; verify your sending domain first.
RESEND_API_KEY=
# Verified sender (the FROM address). BoilerIndy sends from the noreply@ alias.
RESEND_FROM=BoilerIndy <noreply@boilerindy.app>
# Reply-To for transactional email, so replies reach a monitored inbox. noreply@
# is send-only, so point this at support@. Optional (omit to send with no Reply-To).
MAIL_REPLY_TO=support@boilerindy.app
# Physical postal address for CAN-SPAM compliance on any commercial/marketing
# email (issue #116). Transactional mail like password resets doesn't need it,
# so this can stay blank until a marketing/announcement email is added.
# e.g. "BoilerIndy, 123 Example St, Indianapolis, IN 46202"
MAIL_POSTAL_ADDRESS=

# ── Dining (optional, issue #119) ────────────────────────────────────────────
# Menus and hours come from Nutrislice's public JSON API for the iupui district
# (no key, no login): https://iupui.api.nutrislice.com. That district is the
# one both shared halls (Tower Dining, Campus Center) publish to; there is no
# separate Purdue district. Override the base URL to point at another district
# or a local fixture server, or change how long schools and menus are cached in
# milliseconds (open/closed is recomputed on every request regardless).
# Defaults: the iupui district, 43200000 (12 h). Leave blank for defaults.
# See docs/dining.md.
NUTRISLICE_API_BASE=
NUTRISLICE_CACHE_MS=

# ── Parking status (optional, issue #14) ─────────────────────────────────────
# Live garage counts come from IU Parking's public lot-count page (no key, no
# login): https://v2.aitapps.iu.edu/INPARK_LotCount_V1_Online/IN
# Override the source URL (e.g. a locally served copy of test/fixtures/
# inpark-lotcount.html) or the server-side cache TTL in milliseconds.
# Defaults: the IU page, 60000 (never below 15000). Leave blank for defaults.
PARKING_STATUS_URL=
PARKING_STATUS_CACHE_MS=

# ── Club directory (optional, issue #16) ─────────────────────────────────────
# Student organizations come from BoilerLink's public organizations API (no
# key, no login): https://boilerlink.purdue.edu/api/discovery/search/organizations
# Override the source URL (e.g. a locally served copy of test/fixtures/
# boilerlink-organizations.json) or the server-side cache TTL in milliseconds.
# Defaults: the BoilerLink API, 21600000 (6 h, never below 300000). Leave blank
# for defaults. See docs/clubs.md.
BOILERLINK_CLUBS_URL=
BOILERLINK_CLUBS_CACHE_MS=

# ── Push notifications (optional, issue #9) ──────────────────────────────────
# Web Push needs a VAPID key pair. Generate one with `pnpm run vapid:generate`
# (or `node scripts/generate-vapid-keys.mjs`) and paste the two values here and
# on the host (Render). Leave both blank to keep push switched off: the API
# then reports enabled:false and the Settings card says so. Rotating the pair
# invalidates every existing subscription. See docs/push-notifications.md.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact push services can reach (mailto: or https:). Default when blank:
# mailto:support@boilerindy.app
VAPID_SUBJECT=
# Bearer token for the internal cron routes: POST /api/internal/push/run-reminders
# (deadline reminders, every 5 minutes, db/supabase-push.sql) and
# POST /api/internal/sources/resync (hourly calendar re-sync, issue #12,
# db/supabase-source-resync.sql). Any long random string (openssl rand -hex 32).
# Blank means neither route exists.
PUSH_CRON_SECRET=

# Marketplace photo uploads reuse SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY and
# SESSION_SECRET (minimum 32 characters). No client-side secret or migration.
# Public bucket marketplace-images: JPEG/PNG/WebP, maximum 5242880 bytes.
# See docs/marketplace-photos.md for deployment, smoke test and cleanup commands.
# RATE_LIMIT_MARKETPLACE_PHOTO_MAX=20
# RATE_LIMIT_MARKETPLACE_PHOTO_WINDOW_MS=3600000

# Keeps dotenv quiet at boot. From dotenv 17 the loader prints a summary line
# ("injected env (N) from .env") plus a rotating tip on every start; Render has
# no .env file, so on the free tier that noise lands right where a cold start is
# being diagnosed. Harmless on dotenv 16, which ignores it.
DOTENV_CONFIG_QUIET=true

# ── Advanced (optional) ───────────────────────────────────────────────────────
# Read by the server but rarely set. Every one of these has a working default;
# the comment says what changes when you set it (issue #210).

# production, development or test. Any other value stops the server at boot with
# an error rather than silently running a half-production configuration. Unset
# means development, which is what `node server.mjs` gets locally. Production
# turns on secure cookies, trust proxy and the debug-route and mock-auth gates.
# NODE_ENV=

# Set to 1 to trust the X-Forwarded-For chain outside production, so req.ip is
# the real client and rate-limit buckets are per client rather than one shared
# bucket for everyone behind the proxy. Production always trusts the proxy, so
# this only matters for a staging or tunnelled local run behind one.
# TRUST_PROXY=1

# Public base URL the backend uses when it builds links to itself (the Purdue
# link redirect, the calendar feed URL). Defaults to BETTER_AUTH_URL, then to
# http://HOST:PORT, which is wrong the moment the server is behind a domain.
# BACKEND_PUBLIC_URL=https://api.boilerindy.app

# Required when PURDUE_AUTH_MODE=cas. The login endpoint students are sent to,
# and the ticket validation endpoint the callback calls. With PURDUE_AUTH_MODE
# unset or mock (the default for local dev) neither is read.
# PURDUE_CAS_LOGIN_URL=
# PURDUE_CAS_VALIDATE_URL=

# Extra blocked words for the board and guide profanity filter, comma separated,
# added to the built-in list. Read once at first use, so a change needs a
# restart. Blank means the built-in list only.
# BOARD_BLOCKED_WORDS=

# Local-only: where the Purdue schedule auto-capture finds its browser. Set
# either when Playwright's Chromium is not in the default cache, for instance
# after installing browsers to a custom path. Neither is read in production,
# where auto-capture does not run.
# PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=
# PLAYWRIGHT_BROWSERS_PATH=

# ── Scripts only ──────────────────────────────────────────────────────────────
# Read by files in scripts/, never by the server. Set them inline for one run
# rather than putting them in .env.

# scripts/create-advertiser.mjs: the portal account it creates.
# ADVERTISER_EMAIL=
# ADVERTISER_PASSWORD=
# ADVERTISER_COMPANY=
# ADVERTISER_CONTACT=

# scripts/test-marketplace-photo-storage.mjs: the anon (publishable) Supabase key,
# so the smoke test can also check what an unauthenticated client may read. The
# script runs without it and skips that half of the check.
# SUPABASE_SMOKE_PUBLIC_KEY=

# ── Deprecated ────────────────────────────────────────────────────────────────
# Still read, still working, and slated for removal. Prefer the replacement.

# Fallback for SESSION_SECRET. Set SESSION_SECRET instead.
# BETTER_AUTH_SECRET=

# Fallback for BACKEND_PUBLIC_URL. Set BACKEND_PUBLIC_URL instead.
# BETTER_AUTH_URL=

# The AI provider moved from xAI to Groq. This name is only read to print a boot
# warning when GROQ_API_KEY is missing and this one is set, so the cause of a
# silent assistant is obvious. Set GROQ_API_KEY and remove this.
# XAI_API_KEY=
