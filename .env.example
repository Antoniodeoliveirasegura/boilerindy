# BoilerIndy — Backend environment variables
# Copy this file to .env and fill in your values.
#
#   cp .env.example .env
#
# NEVER commit .env to git. It is already in .gitignore.

# ── Supabase ──────────────────────────────────────────────────────────────────
# Find these in your Supabase project: Settings → API

# Project URL (same for backend and frontend)
SUPABASE_URL=https://your-project-id.supabase.co

# Service role key — has full DB access, keep secret, backend only
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Anon / public key — required for Supabase Auth password verification (never use service role here)
SUPABASE_ANON_KEY=your-anon-public-key-here

# ── Express server ────────────────────────────────────────────────────────────
PORT=3000
HOST=127.0.0.1

# Use a long random string in production (required when NODE_ENV=production).
SESSION_SECRET=change-this-to-a-long-random-string

# ── Frontend URL (for auth redirects) ─────────────────────────────────────────
# Must match the port Vite is running on (default: 5173)
CLIENT_APP_URL=http://localhost:5173

# ── Purdue auth ───────────────────────────────────────────────────────────────
# 'mock' for local development — skips real Purdue CAS login
# 'cas'  for production — requires PURDUE_CAS_LOGIN_URL and PURDUE_CAS_VALIDATE_URL
PURDUE_AUTH_MODE=mock

# Pre-filled email shown on the mock Purdue link screen (dev only)
DEV_PURDUE_EMAIL=student@purdue.edu

# Comma-separated student emails with platform admin access (also set is_admin in DB)
ADMIN_EMAILS=

# ── Rate limiting (optional) ──────────────────────────────────────────────────
# All API rate limiters are ON by default. See docs/RATE_LIMITS.md for the
# endpoint coverage table and per-limiter override variables, e.g.:
#   RATE_LIMIT_SIGN_IN_MAX=20
#   RATE_LIMIT_SIGN_IN_WINDOW_MS=900000
# Set to false only for local load testing.
RATE_LIMIT_ENABLED=true

# ── Gemini AI (optional) ──────────────────────────────────────────────────────
# Powers the campus assistant (/api/assistant) and board AI features.
# Get a free key at https://aistudio.google.com/app/apikey
# Leave blank to disable AI features without breaking the rest of the app.
GEMINI_API_KEY=your-gemini-api-key-here

# ── Transit (optional) ────────────────────────────────────────────────────────
# TransLoc API key for campus bus proxy endpoints
TRANSLOC_API_KEY=your-transloc-api-key-here

# ── Sentry error tracking (optional, issue #50) ──────────────────────────────
# Node project DSN from sentry.io. Leave blank locally — with no DSN, Sentry is
# fully disabled and zero events are sent. Set the real value on the host
# (e.g. Render dashboard), never in the repo.
SENTRY_DSN=

# ── Email / Resend (optional) ─────────────────────────────────────────────────
# Powers the advertiser self-serve password reset (forgot-password). Leave both
# blank locally — with no key the reset email is skipped and the reset link is
# logged to the server console instead, so the flow is still testable in dev.
# Get a key at https://resend.com → API Keys; verify your sending domain first.
RESEND_API_KEY=
# Verified sender, e.g. "BoilerIndy <noreply@boilerindy.app>"
RESEND_FROM=
# Physical postal address for CAN-SPAM compliance on any commercial/marketing
# email (issue #116). Transactional mail like password resets doesn't need it,
# so this can stay blank until a marketing/announcement email is added.
# e.g. "BoilerIndy, 123 Example St, Indianapolis, IN 46202"
MAIL_POSTAL_ADDRESS=
