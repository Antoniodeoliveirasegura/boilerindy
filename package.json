{
  "name": "boilerindy",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.6.0",
  "engines": {
    "node": "^22.22.2 || ^24.15.0"
  },
  "scripts": {
    "preinstall": "npx -y only-allow pnpm",
    "prepare": "node scripts/setup-git-hooks.mjs",
    "dev": "node server.mjs",
    "start": "node server.mjs",
    "test": "node --test \"test/**/*.test.mjs\" && pnpm -C boilerindy-react test",
    "test:backend": "node --test \"test/**/*.test.mjs\"",
    "test:e2e": "playwright test",
    "check:conventions": "node scripts/check-conventions.mjs dashes && node scripts/check-conventions.mjs commits",
    "check:db": "node scripts/check-db-apply.mjs",
    "docs:routes": "node scripts/list-routes.mjs --write",
    "playwright:install": "playwright install chromium",
    "vapid:generate": "node scripts/generate-vapid-keys.mjs"
  },
  "dependencies": {
    "@sentry/node": "^10.75.0",
    "@supabase/supabase-js": "^2.116.0",
    "dotenv": "^18.0.1",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "node-ical": "^0.27.2"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "playwright": "1.63.0"
  }
}
